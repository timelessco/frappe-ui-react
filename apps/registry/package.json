{
	"name": "registry",
	"version": "0.0.0",
	"private": true,
	"description": "Shadcn component registry",
	"keywords": [
		"react",
		"next-react-app",
		"typescript"
	],
	"homepage": "https://github.com/timelessco/frappe-ui-react",
	"bugs": {
		"url": "https://github.com/timelessco/frappe-ui-react/issues"
	},
	"repository": {
