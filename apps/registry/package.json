{
	"name": "registry",
	"version": "0.0.0",
	"private": true,
	"description": "Shadcn component registry",
	"keywords": [
		"react",
		"next-react-app",
		"typescript"
	],
	"homepage": "https://github.com/timelessco/frappe-ui-react",
	"bugs": {
		"url": "https://github.com/timelessco/frappe-ui-react/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/timelessco/frappe-ui-react.git",
		"directory": "apps/registry"
	},
	"license": "MIT",
	"author": {
		"name": "Timeless // Navin Moorthy",
		"email": "hello@timeless.co",
		"url": "https://timeless.co/"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm registry:source && pnpm registry:build && next build",
		"build:ci": "pnpm registry:source && next build",
		"build:start": "pnpm build && pnpm start",
		"build:vinext": "pnpm registry:source && vite build",
		"clean": "rimraf ./.next ./tsconfig.tsbuildinfo",
		"deploy:vinext": "vinext-cloudflare deploy",
		"dev": "pnpm registry:source && next dev --turbopack",
		"dev:vinext": "pnpm registry:source && vite dev --port 3001",
		"fix:eslint": "eslint --cache --color --fix .",
		"lint:eslint": "eslint --cache --color .",
		"lint:types": "tsc --noEmit",
		"registry:build": "shadcn build",
		"registry:source": "node scripts/build-registry-source.mjs",
		"start": "next start",
		"start:vinext": "vite preview",
		"test": "echo \"no test specified\" && exit 0"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {
		"@mdx-js/loader": "3.1.1",
		"@mdx-js/react": "3.1.1",
		"@next/mdx": "16.4.6",
		"@radix-ui/react-avatar": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-tabs": "1.2.1",
		"@types/mdx": "2.0.14",
		"@types/prismjs": "1.26.6",
		"@vinext/cloudflare": "1.3.4",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"hast-util-to-html": "9.0.6",
		"lucide-react": "1.72.0",
		"next": "16.4.6",
		"next-themes": "0.4.6",
		"prismjs": "1.30.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-server-dom-webpack": "19.3.1",
		"shadcn": "4.23.0",
		"tailwind-merge": "3.7.0",
		"tailwindcss-animate": "1.0.7",
		"vinext": "1.4.5",
		"zod": "3.24.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.v.14",
		"@mdx-js/rollup": "3.1.1",
		"@next/env": "16.4.6",
		"@next/eslint-plugin-next": "16.4.6",
		"@tailwindcss/typography": "0.5.20",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"@vitejs/plugin-rsc": "0.5.39",
		"autoprefixer": "10.6.2",
		"cf": "1.0.0-beta.29",
		"eslint": "10.14.0",
		"eslint-config-canonical": "47.4.2",
		"eslint-config-flat-gitignore": "2.4.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-tailwindcss": "4.4.0",
		"eslint-plugin-yml": "3.10.0",
		"lint-staged": "17.6.0",
		"postcss": "8.5.3",
		"rimraf": "6.1.4",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"vite": "8.3.0"
	}
}
