{
	"name": "frappe-ui-react-native",
	"version": "1.0.0",
	"description": "Frappe UI React Native Registry",
	"license": "MIT",
	"scripts": {
		"start": "expo start --dev-client",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"build:dev": "eas build --profile development",
		"build:preview": "eas build --profile preview",
		"build:prod": "eas build --profile production",
		"prebuild": "expo prebuild",
		"lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
		"format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
		"web": "expo start --web"
	},
	"dependencies": {
		"@react-navigation/drawer": "^7.1.1",
		"@react-navigation/native-stack": "^7.2.0",
		"clsx": "^2.1.1",
		"expo": "^57.0.0",
		"expo-dev-client": "~57.0.0",
		"expo-dev-launcher": "^57.0.0",
		"expo-font": "~57.0.0",
		"expo-haptics": "~57.0.0",
		"expo-status-bar": "~57.0.0",
		"nativewind": "^4.1.23",
		"react": "19.2.8",
		"react-native": "0.87.0",
		"react-native-gesture-handler": "~3.2.0",
		"react-native-reanimated": "~4.5.0",
		"react-native-safe-area-context": "5.9.0",
		"react-native-svg": "15.15.5",
		"tailwindcss": "^4.0.0",
		"react-native-screens": "~4.27.0",
		"react-native-pager-view": "9.0.2"
	},
	"devDependencies": {
		"@babel/core": "^8.0.0",
		"@types/react": "~19.2.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^10.0.0",
		"eslint-config-universe": "^16.0.0",
		"prettier": "^3.2.5",
		"typescript": "~7.0.0"
	},
	"eslintConfig": {
		"extends": "universe/native",
		"root": true
	},
	"main": "node_modules/expo/AppEntry.js",
	"private": true
}
